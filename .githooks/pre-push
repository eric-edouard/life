#!/bin/sh
cd "$(git rev-parse --show-toplevel)" || exit 1
# git runs hooks with GIT_DIR and friends set; from a worktree they would point every `git -C <dir>` the check runs
# (tests on temp repos included) at this repo: git.test.ts's `git init` once set core.bare=true. The check gets a plain
# shell's environment.
unset $(git rev-parse --local-env-vars)
if ! bun run check; then
  echo "Push blocked: bun run check failed."
  exit 1
fi
