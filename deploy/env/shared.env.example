# What Life and the voice server share. The bucket (R2) takes one key pair and one restic password for both
# repositories: keep the password in your password manager, without it the backups can't be read.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESTIC_PASSWORD=
# Your time zone (a server's own zone is not yours), e.g. Asia/Bangkok: your days and the backups' Sundays.
TZ=
