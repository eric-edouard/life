# The voice server's own (every variable: apps/voice/.env.example). compose.yaml sets the paths, the port, restic
# and IDENTITY_URL.
# Its public address, e.g. https://voice.example.com.
PUBLIC_BASE_URL=
# sha256 hex of the phone's token: `bun run --cwd apps/voice mint-token`.
DEVICE_TOKEN_HASH=
ELEVENLABS_API_KEY=
# The daily restic backup, e.g. s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/life-server-backup/voice.
RESTIC_REPOSITORY=
# ElevenLabs' webhook: without it a restart (an update) can leave a send unanswered and its block untranscribed.
# ELEVENLABS_WEBHOOK_SECRET=
# ELEVENLABS_WEBHOOK_ID=
