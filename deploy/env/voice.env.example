# The voice server's secrets (apps/voice/src/config.ts `Env`). compose.yaml sets the paths, the port and IDENTITY_URL.
PUBLIC_BASE_URL=https://voice.example.com
# sha256 hex of the phone's token: `bun run --cwd apps/voice mint-token`.
DEVICE_TOKEN_HASH=
ELEVENLABS_API_KEY=
# The same as in speech.env.
IDENTITY_SECRET=
# Life's sign-in (32+ characters) and Life's address.
# AUTH_SECRET=
# LIFE_URL=https://life.example.com
# The daily restic backup to its own repository in the bucket; restic reads the bucket's keys from AWS_*.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/life-server-backup/voice
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
