# Life's keys, read by `bun life headless` (installed as /srv/life/life/state/secrets.env). Its settings are
# state/settings.json (docs/use/server.md).
OPENROUTER_API_KEY=
# The backup: the `backup` setting's password command is `printenv LIFE_BACKUP_PASSWORD`, its repository
# s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/life-server-backup/life; restic reads the bucket's keys from AWS_*.
LIFE_BACKUP_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Your time zone, for your days (a server's own zone is not yours), e.g. Asia/Bangkok.
TZ=
