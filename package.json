{
  "name": "life",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "apps/lifelog/apps/*",
      "apps/lifelog/packages/*",
      "packages/*"
    ],
    "catalog": {
      "@better-auth/oauth-provider": "1.7.7",
      "@modelcontextprotocol/server": "2.3.1",
      "@types/bun": "1.4.3",
      "better-auth": "1.7.7",
      "drizzle-kit": "0.31.11",
      "drizzle-orm": "0.45.3",
      "zod": "^4.6.5"
    }
  },
  "scripts": {
    "bench": "bun scripts/bench.ts",
    "check": "bun scripts/check.ts",
    "fix": "bun x --bun ultracite fix && swift format --in-place --recursive apps/lifelog/apps/ios apps/lifelog/apps/mac-quiet",
    "life": "bun apps/server/src/host/cli.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@life/server": "workspace:*",
    "@modelcontextprotocol/server": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@life/config": "workspace:*",
    "@types/bun": "catalog:",
    "fallow": "3.32.0",
    "typescript": "7.0.2",
    "ultracite": "7.12.4"
  },
  "packageManager": "bun@1.4.2"
}
