# The owner's lifelog device token (read-only REST access)
LIFELOG_TOKEN=
# The owner's personal Resend key: the nightly report and the alerts, by email
RESEND_PERSONAL_API_KEY=
# The owner's address: the nightly report and the alerts go there only
LIFE_MAIL_TO=
# Life's own Beeper chat (its old Telegram bot), dropped as its own output
LIFE_CHAT=
# The word lifelog hears instead of "Atlas" (a real name, so "hey <word>" wakes only on his own turns, as low confidence)
LIFE_MISHEARD=
# Life's connector (src/mcp.ts): the owner's account id in lifelog's OAuth server; only his tokens are accepted. Unset: /mcp is off
LIFE_OWNER_SUB=the-owner-account-id
# The bench's OpenRouter models only (scripts/bench.ts); nothing else reads it.
OPENROUTER_API_KEY=
