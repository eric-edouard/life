# Secrets for a checkout (Life.app keeps them in the Keychain instead). Never commit .env.
# The voice server's device token (read-only REST access), for the voice source
VOICE_TOKEN=
# Resend API key, used when the `mail` setting is on (the nightly report and the alerts by email)
RESEND_PERSONAL_API_KEY=
# An API-key engine (`anthropic` or `openai`), for an install without a Claude or Codex subscription
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# The portrait pages (/me): their password; unset, /me is off
LIFE_PORTRAIT_PASSWORD=
# The model bench's OpenRouter calls only (scripts/bench.ts)
OPENROUTER_API_KEY=
# Build: the signing identity for `bun scripts/app.ts` (an Apple-issued certificate); unset, ad hoc signing
LIFE_SIGN_IDENTITY=
