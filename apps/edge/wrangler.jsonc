// Life's public edge (edge.ts). Deploy from ~/Work/life with .env loaded:
//   set -a; . ./.env; set +a; bun x wrangler@4.40.0 deploy -c apps/edge/wrangler.jsonc \
//     --var MAC_ORIGIN:https://<his Mac's tailnet name>:8443   (kept out of the repo)
// Every path is routed here and passed to the Mac over Tailscale Funnel (MAC_ORIGIN).
{
  "name": "life-status",
  "main": "edge.ts",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "life.ericedouard.com/*", "zone_name": "ericedouard.com" }
  ],
  "workers_dev": false
}
