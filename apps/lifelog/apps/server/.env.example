# The server's environment. What each variable does is `Env` in src/config.ts. Lifelog Host sets the archive's
# paths, the token hashes, the keys and restic itself; anything else goes in its server.env.

# Needed to boot.
DATABASE_PATH=./archive.sqlite
# sha256 hex of the phone's token: `bun run mint-token`.
DEVICE_TOKEN_HASH=
ELEVENLABS_API_KEY=
PUBLIC_BASE_URL=https://my-mac.example.ts.net
# Audio: a folder on this machine, or all five S3_* settings (a bucket), which win when set.
AUDIO_DIR=./audio
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Where it listens (PORT defaults to 3000; every interface without LISTEN_HOST).
# LISTEN_HOST=127.0.0.1
# PORT=3000

# Other tokens, each a hash from `bun run mint-token mac|read|corrections`.
# MAC_TOKEN_HASH=
# READ_TOKEN_HASH=
# CORRECTIONS_TOKEN_HASH=

# Search by meaning (keyword search works without it).
# OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-large

# ElevenLabs: the webhook, for a server the internet can reach (without it each send waits for its transcript),
# and how many jobs it has there at once.
# ELEVENLABS_WEBHOOK_SECRET=
# ELEVENLABS_WEBHOOK_ID=
# ELEVENLABS_SLOTS=10
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# Speaker recognition (apps/identity), with the same secret as that service.
# IDENTITY_URL=http://127.0.0.1:8000
# IDENTITY_SECRET=

# The daily restic backup: all three or none.
# RESTIC_BINARY=
# RESTIC_REPOSITORY=
# RESTIC_PASSWORD=

# Pushes to the phone (a token-based .p8 key).
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=
# APNS_TOPIC=
# APNS_ENVIRONMENT=sandbox

# Alert emails through Resend, from a domain verified there; none without all three.
# RESEND_API_KEY=
# ALERT_EMAIL_FROM=Lifelog <alerts@your.domain>
# ALERT_EMAIL_TO=

# Signs a reader's OAuth tokens (32+ characters), for Life at LIFE_URL; the sign-in is off without both.
# AUTH_SECRET=
# LIFE_URL=https://life.example.com

# The build's git commit, naming server error reports (Lifelog Host passes it).
# BUILD_SHA=
