{
  "name": "lifelog",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@better-auth/oauth-provider": "1.7.7",
      "@types/bun": "1.4.3",
      "better-auth": "1.7.7",
      "drizzle-kit": "0.31.11",
      "drizzle-orm": "0.45.3"
    }
  },
  "scripts": {
    "check": "bun scripts/check.ts",
    "check:offline": "cd apps/ios && xcodegen generate --quiet && xcodebuild test -project Lifelog.xcodeproj -scheme Lifelog -only-testing:LifelogUITests -destination \"platform=iOS Simulator,name=${SIMULATOR:-iPhone 17}\" -derivedDataPath ../../.build/DerivedData -quiet",
    "events": "bun scripts/events.ts",
    "fix": "biome check --write . && swift format --in-place --recursive apps/ios apps/mac-quiet",
    "host:app": "bun scripts/host-app.ts",
    "install:phone": "bun scripts/install-phone.ts",
    "ios:project": "cd apps/ios && xcodegen generate --quiet",
    "switches": "bun scripts/switches.ts",
    "symbolicate": "bun scripts/symbolicate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "fallow": "3.32.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "ultracite": "7.12.4"
  },
  "packageManager": "bun@1.4.2"
}
