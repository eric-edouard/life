{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "scripts/*.ts",
    "assets/**/*.js",
    "assets/**/*.tsx",
    "assets/**/*.css",
    "worker/*.ts"
  ],
  "ignoreUnresolvedImports": ["./tokens.css"],
  "ignoreDependencies": ["@openai/codex", "fallow", "ultracite"],
  "ignorePatterns": [".claude/**"],
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 25,
    "maxCrap": 420
  },
  "ignoreExportsUsedInFile": true
}
