{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "scripts/*.ts",
    "assets/**/*.js",
    "assets/**/*.css",
    "apps/edge/*.ts",
    "apps/web/src/main.tsx",
    "apps/web/vite.config.ts",
    "apps/lifelog/apps/server/fixtures/fake-restic.ts",
    "apps/lifelog/scripts/*.ts"
  ],
  "ignoreUnresolvedImports": ["./tokens.css"],
  "ignoreDependencies": ["@openai/codex", "fallow", "ultracite"],
  "ignorePatterns": [".claude/**"],
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 25,
    "maxCrap": 420
  },
  "ignoreExportsUsedInFile": true,
  "boundaries": {
    "zones": [
      {
        "name": "core",
        "patterns": ["apps/server/src/core/**"]
      },
      {
        "name": "records",
        "patterns": ["apps/server/src/records/**"]
      },
      {
        "name": "models",
        "patterns": ["apps/server/src/models/**"]
      },
      {
        "name": "sources",
        "patterns": ["apps/server/src/sources/**"]
      },
      {
        "name": "todo-list",
        "patterns": ["apps/server/src/todo-list/**"]
      },
      {
        "name": "payments",
        "patterns": ["apps/server/src/payments/**"]
      },
      {
        "name": "memory",
        "patterns": ["apps/server/src/memory/**"]
      },
      {
        "name": "host",
        "patterns": ["apps/server/src/host/**"]
      },
      {
        "name": "web",
        "patterns": ["apps/web/**"]
      }
    ],
    "rules": [
      {
        "from": "core",
        "allow": []
      },
      {
        "from": "records",
        "allow": ["core"]
      },
      {
        "from": "models",
        "allow": ["core", "records"]
      },
      {
        "from": "sources",
        "allow": ["core", "records"]
      },
      {
        "from": "todo-list",
        "allow": ["core", "records"]
      },
      {
        "from": "payments",
        "allow": ["core"]
      },
      {
        "from": "memory",
        "allow": [
          "core",
          "models",
          "sources",
          "todo-list",
          "payments",
          "records"
        ]
      },
      {
        "from": "host",
        "allow": [
          "core",
          "models",
          "sources",
          "todo-list",
          "payments",
          "memory",
          "records"
        ]
      },
      {
        "from": "web",
        "allow": ["records"]
      }
    ]
  }
}
