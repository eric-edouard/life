{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "includes": [
      "!!.claude",
      "!!apps/lifelog/apps/server/src/voices/plotly-4.0.0.min.js",
      "!!apps/lifelog/apps/ios",
      "!!apps/lifelog/research-fixtures",
      "!!apps/lifelog/docs/research/*.html"
    ]
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/lifelog/apps/server/src/grouping.test.ts",
        "apps/lifelog/apps/server/src/grouping.ts",
        "apps/lifelog/apps/server/src/intelligence.test.ts",
        "apps/lifelog/apps/server/src/jobs.test.ts",
        "apps/lifelog/apps/server/src/jobs.ts",
        "apps/lifelog/apps/server/src/mac-llm.test.ts",
        "apps/lifelog/apps/server/src/naming-queue.test.ts",
        "apps/lifelog/apps/server/src/people.test.ts",
        "apps/server/src/host/status/snapshot.ts",
        "apps/server/src/memory/observe.test.ts",
        "apps/server/src/memory/units.test.ts",
        "apps/server/src/sources/lifelog.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    }
  ],
  "linter": {
    "rules": {
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 800
          }
        }
      }
    }
  }
}
